---
import config from "../../../photobook.config";
import Photobook from "../../components/Photobook.astro";
import { getCollections } from "../../data/photos";

const hasCollections = (await getCollections()).length > 0;
---

<Photobook
  title={hasCollections ? `Collections | ${config.title}` : config.title}
  view={{ kind: hasCollections ? "collections" : "root" }}
  fallback={!hasCollections}
/>
